# Función para corrección de sesgo Box-Cox
correccion_boxcox <- function(y_hat, var_e, lambda) {
  if(lambda == 0) {
    return(exp(var_e / 2))
  } else {
    term <- 1 + lambda * y_hat
    correc <- (0.5 + ((sqrt(1-(2*lambda*(lambda-1)*var_e)/term^2))/2))^(1/lambda)
    return(correc)
  }
}

pronoriginal <- function(fit, h = 10, lambda = 0, alpha = 0.05) { #damos horizonte, lambda y significancia
  y_hat <- pronoptimo(fit, h = h) #pronostico transformado
  sigma2 <- var(residuals(fit))            #varianza de residuos
  
  p <- fit$arma[1] #obtiene p y q (arima(p,d,q) )
  q <- fit$arma[2]
  
  phi <- if (p > 0) fit$coef[1:p] else numeric(0) #obtiene phis y thetas
  theta <- if (q > 0) fit$coef[(p+1):(p+q)] else numeric(0)
  
  #calcular psis
  psi <- numeric(h)
  psi0 <- 1   #psi0 = 1
  
  for (j in 1:h) {
    sum_phi_psi <- 0
    if (p > 0) {
      for (i in 1:p) {
        if (j - i > 0) {
          sum_phi_psi <- sum_phi_psi + phi[i] * psi[j - i]
        } else if (j - i == 0) {
          sum_phi_psi <- sum_phi_psi + phi[i] * psi0
        }
      }
    }
    
    theta_j <- if (q > 0 && j <= q) theta[j] else 0
    psi[j] <- theta_j + sum_phi_psi
  }
  
  ##psis para varianza de error
  psi_full <- c(psi0, psi) #incluimos psi0
  var_e_h <- sigma2 * cumsum(psi_full[1:h]^2)
  
  #correccion de box cox, en funcion arriba
  correc <- mapply(correccion_boxcox, y_hat, var_e_h, MoreArgs = list(lambda = lambda))
  
  ###calcular la inversa por la correccion
  pron <- if (lambda == 0) {
    exp(y_hat) * correc
  } else {
    (1 + lambda * y_hat)^(1/lambda) * correc
  }
  
  ###intervalos de prediccion
  z_alpha <- qnorm(1 - alpha/2)
  IC_lower <- numeric(h)
  IC_upper <- numeric(h)
  
  for (i in 1:h) {
    yl <- y_hat[i] - z_alpha * sqrt(var_e_h[i])
    yu <- y_hat[i] + z_alpha * sqrt(var_e_h[i])
    
    if (lambda == 0) {
      IC_lower[i] <- correc[i] * exp(yl)
      IC_upper[i] <- correc[i] * exp(yu)
    } else {
      IC_lower[i] <- correc[i] * (1 + lambda * yl)^(1/lambda)
      IC_upper[i] <- correc[i] * (1 + lambda * yu)^(1/lambda)
    }
  }
  
  return(list(pron = pron, IC = cbind(IC_lower, IC_upper), psi = psi))
}


