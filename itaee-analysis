#############PRONOSTICO OPTIMO
pronoptimo <- function(fit, h = 1) {
  
  #parámetros del modelo
  coefs <- fit$coef #coeficientes del modelo ARIMA
  p <- fit$arma[1] #AR
  d <- fit$arma[6] #I
  q <- fit$arma[2] #MA
  
  #guardar terminos ar y ma
  phi <- if(p > 0) coefs[1:p] else numeric(0)
  theta <- if(q > 0) coefs[(p+1):(p+q)] else numeric(0)
  
  y <- fit$x # serie para ajustar el modelo
  res <- residuals(fit) # residuos
  
  if(d > 0) {
    w <- diff(y, differences = d) # serie diferenciada
  } else {
    w <- y # si no hay diferencias, usar la serie original
  }
  
  n <- length(w) # longitud de la serie diferenciada
  wf <- numeric(h) # vector para pronósticos
  
  for(k in 1:h) {
    pred <- 0 # inicializa predicción del paso k
    
    #parte AR
    if(p > 0) {
      for(i in 1:p) {
        if(k - i > 0) {
          pred <- pred + phi[i] * wf[k - i] # usa pronósticos ya calculados (si es que hay)
        } else if(n + k - i > 0) {
          pred <- pred + phi[i] * w[n + k - i] #usa últimos valores de la serie
        }
      }
    }
    
    #parte MA
    if(q > 0) {
      for(j in 1:q) {
        if(k - j > 0) {
          pred <- pred + theta[j] * 0 # E(error futuro) = 0
        } else if(length(res) + k - j > 0) {
          pred <- pred + theta[j] * res[length(res) + k - j]  #errores pasados
        }
      }
    }
    wf[k] <- pred  # guardar el pronóstico del paso k
  }
  
  if(d == 0) {
    y_hat <- wf # sin diferenciación, el pronóstico ya está en la escala original
  } else if(d == 1) {
    y_hat <- numeric(h)
    y_last <- tail(y,1) # último valor original de la serie
    for(k in 1:h) {
      y_hat[k] <- y_last + sum(wf[1:k])  # sumar las diferencias acumuladas
    }
  } else if(d == 2) {
    dy_last <- y[length(y)] - y[length(y)-1]  # última diferencia
    y_last <- y[length(y)]
    y_hat <- numeric(h)
    for(k in 1:h) {
      y_hat[k] <- y_last + k*dy_last + sum((k:1) * wf[1:k])  # reintegrar segunda diferencia
    }
  }
  return(y_hat)  #devolver vector con los pronósticos
}

