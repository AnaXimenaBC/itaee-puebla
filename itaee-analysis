#### Verificacion de supuestos ####
verificar8 <- function(modelo){
  res <- residuals(modelo)
  cat("\n1) ERRORES DE MEDIA CERO (t-test)")
  cat("\n ---------------------------------- \n")
  print(t.test(res, mu = 0))
  
  cat("\n2) VARIANZA CONSTANTE")
  cat("\n ---------------------------------- \n")
  
  # breusch pagan
  tiempo <- 1:length(res)
  lm_aux <- lm(res ~ tiempo)
  print(bptest(lm_aux))
  
  #rresiduos vs tiempo
  print(
    ggplot(data.frame(tiempo, res), aes(tiempo, res), xlab = 'Tiempo', ylab = 'Residuos') +
      geom_point() + geom_smooth(se = FALSE, col="red") +
      ggtitle("Residuos vs Tiempo (Homoscedasticidad)") + xlab('Tiempo') + ylab('Residuos') +
      theme_minimal()
  )
  
  
  cat("\n3) NORMALIDAD DE LOS ERRORES")
  cat("\n ---------------------------------- \n")
  
  #anderson-darling
  print(ad.test(res))
  
  #histograma
  print(
    ggplot(data.frame(res), aes(x = res)) +
      geom_histogram(bins = 20, fill="skyblue", color="black") +
      ggtitle("Histograma de residuos") +
      xlab("Residuos") +
      ylab("Cuenta") +
      theme_minimal()
  )
  
  #qq plot
  qqnorm(res, xlab = 'Residuos', ylab = 'Cuenta', main = 'Gráfica Q-Q Plot'); qqline(res, col="red", lwd=2)
  
  cat("\n4) INDEPENDENCIA DE ERRORES")
  cat("\n ---------------------------------- \n")
  
  print(Box.test(res, lag = 20, type="Ljung-Box"))
  print(Box.test(res, lag = 20, type="Box-Pierce"))
  
  print(ggAcf(res) + ggtitle("ACF de los residuos") + theme_minimal())
  print(ggPacf(res) + ggtitle("PACF de los residuos") + theme_minimal())
  
  cat("\n5) PARSIMONIA")
  cat("\n ---------------------------------- \n")
  
  print("Intervalos de confianza de los parámetros:")
  print(confint(modelo))
  
  cat("\nAIC / BIC:\n")
  print(AIC(modelo))
  print(BIC(modelo))
  
  cat("\n6) MODELO ADMISIBLE")
  cat("\n ---------------------------------- \n")
  
  # estacionariedad/invertibilidad
  print("Raíces del polinomio AR (estacionariedad):")
  print(Mod(polyroot(c(1, -modelo$model$phi))))
  
  print("Raíces del polinomio MA (invertibilidad):")
  print(Mod(polyroot(c(1, modelo$model$theta))))
  
  #verificación región admisible para 1d0 2d0 1d1 0d1 0d2
  p <- modelo$arma[1]; d <- modelo$arma[6]; q <- modelo$arma[2]
  if(p <= 2 & q <= 2){  
    cat("\nsí se puede ver\n")
  } else {
    cat("\nModelo fuera del rango (p,d,q)\n")
  }
  
  cat("\n7) MODELO ESTABLE")
  cat("\n ---------------------------------- \n")
  
  # Correlación entre parámetros
  mat_cor <- solve(modelo$var.coef)
  cat("Correlaciones entre parámetros:\n")
  print(cov2cor(modelo$var.coef))
  
  cat("\n8) OUTLIERS E INFLUENCIA")
  cat("\n ---------------------------------- \n")
  
  #residuos estándar
  res_std <- res / sd(res)
  plot(res_std, type="h", main="Residuos estandarizados")
  
  #residuos studentizados
  library(MASS)
  res_stud <- rstudent(lm_aux)
  plot(res_stud, type="h", main="Residuos studentizados")
  
  #distancia de cook
  cooks <- cooks.distance(lm_aux)
  plot(cooks, type="h", main="Distancia de Cook", xlab = 'Tiempo', ylab = 'Residuos')
  abline(h = 4/length(cooks), col="red", lwd=2)
  
  cat("\nfin\n")
}

